{
  "name": "datagvat-mcp-docs",
  "version": "1.0.0",
  "description": "Documentation for data.gv.at MCP Server",
  "private": true,
  "scripts": {
    "prebuild": "bun run scripts/index-docs.ts && bun run scripts/prebuild.ts",
    "postbuild": "bun run scripts/postbuild.ts",
    "build": "bun run prebuild && next build && bun run postbuild",
    "validate": "bun run lint && bun run lint:links && bun run type-check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:links": "bun run scripts/validate-links.ts",
    "format": "biome format --write .",
    "type-check": "bun run scripts/type-check.ts",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "clean": "rimraf .next",
    "dev": "next dev",
    "optimize-images": "bun scripts/optimize-screenshots.mjs",
    "quality:full": "bun scripts/quality-check.ts",
    "start": "next start",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.18",
    "@ai-sdk/react": "^3.0.50",
    "@fumadocs/story": "^0.0.1",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-presence": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/rehype": "^3.21.0",
    "@shikijs/transformers": "^3.21.0",
    "@takumi-rs/image-response": "^0.64.1",
    "ai": "^6.0.48",
    "class-variance-authority": "^0.7.1",
    "d3-force": "^3.0.0",
    "fumadocs-core": "^16.4.7",
    "fumadocs-docgen": "^3.0.5",
    "fumadocs-mdx": "^14.2.6",
    "fumadocs-openapi": "^10.2.6",
    "fumadocs-twoslash": "^3.1.12",
    "fumadocs-typescript": "^5.0.1",
    "fumadocs-ui": "^16.4.7",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "next": "16.1.3",
    "next-themes": "^0.4.6",
    "octokit": "^5.0.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-force-graph-2d": "^1.29.0",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "twoslash": "^0.3.6",
    "unist-util-visit": "^5.1.0",
    "vectra": "^0.12.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@fumadocs/cli": "^1.2.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.6",
    "@types/d3-force": "^3.0.10",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "browserslist-config-baseline": "^0.5.0",
    "next-validate-link": "^1.6.4",
    "postcss": "^8.5.6",
    "simple-git-hooks": "^2.12.1",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "extends browserslist-config-baseline/2024"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "cd docs && biome check --staged --write"
  }
}
